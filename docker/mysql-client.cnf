# ============================================================
# MySQL 客户端默认字符集（挂进容器的 /etc/mysql/conf.d/）
#
# 为什么需要它：官方 mysql 镜像的 locale 是 POSIX，mysql / mysqldump 客户端
# 会因此把默认字符集退回 latin1（MySQL 的 latin1 实际是 cp1252）。
# 这样 ./deploy.sh account、./deploy.sh backup、手工导入 SQL 时，中文（分类名、
# 列注释）会被按 cp1252 解释，落库变成双重编码的乱码。
#
# 注意：建表不再经过这个客户端——schema 由后端启动时的 Flyway 执行
# backend/src/main/resources/db/migration/V1__baseline.sql 建立，字符集由
# JDBC 的 characterEncoding=utf-8 保证。
#
# 容器里的 /etc/my.cnf 有 `!includedir /etc/mysql/conf.d/`，
# 所以这个文件会被 mysql、mysqladmin、mysqldump 一起读到。
# ============================================================
[client]
default-character-set = utf8mb4
