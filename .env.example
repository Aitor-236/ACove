# ============================================================
# ACove Docker 部署配置
# 用法：cp .env.example .env 后按需修改；
#       或者执行 ./deploy.sh init 自动生成并填入随机密钥。
# 该文件已被 .gitignore 忽略，真实密码不要提交进仓库。
# 注意：值里含空格时要用引号包住，否则脚本读取会出错。
# ============================================================

# ---------- 必填 ----------
# MySQL root 密码（MySQL 容器与后端共用这一份）
MYSQL_ROOT_PASSWORD=change-me-mysql-password

# JWT 签名密钥（HS256），生产环境必须换成随机串，建议 32 字节以上
BLOG_JWT_SECRET=change-me-jwt-secret

# ---------- 可选：端口 ----------
# 站点对外端口（Nginx），80 被占用时改成 8081 之类
BLOG_HTTP_PORT=80
# HTTPS 端口；不启用 HTTPS 时不会被用到
BLOG_HTTPS_PORT=443
# 宿主机访问 MySQL 的绑定地址与端口（默认只绑 127.0.0.1，不对公网开放）
BLOG_DB_BIND=127.0.0.1
BLOG_DB_PORT=13306

# ---------- 可选：域名与 HTTPS ----------
# 站点主域名：前端 nginx 用它做 server_name、HTTPS 跳转和证书路径
# （/etc/letsencrypt/live/<域名>/）。换域名只改这里，不再改 nginx 配置。
SITE_DOMAIN=acove.top

# ---------- 可选：其他 ----------
# 库名：MySQL 容器、后端数据源、SQL 脚本共用
BLOG_DB_NAME=blog_db
BLOG_DB_USER=root
# token 有效期（毫秒），默认 24 小时
BLOG_JWT_EXPIRE_TIME=86400000
# 镜像 tag，方便按版本回滚
BLOG_IMAGE_TAG=latest
# JVM 参数：容器里按内存上限的 75% 给堆，避免被 OOM Killer 干掉
JAVA_OPTS="-XX:MaxRAMPercentage=75 -Duser.timezone=Asia/Shanghai"

# ---------- 可选：./deploy.sh account 用，留空则交互输入 ----------
BLOG_ACCOUNT_USERNAME=
BLOG_ACCOUNT_EMAIL=
BLOG_ACCOUNT_PASSWORD=
