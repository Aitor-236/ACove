# 主机安装的 Nginx 示例（不用 Docker）。无域名时也能通过服务器 IP 访问。
# 按实际情况修改前端发布目录；有域名后可把 server_name 改为域名。
# 放入 Nginx 的站点配置目录；此文件是 server 配置，不是完整 nginx.conf。
# 首次启用先通过 HTTP 检查站点，再在主机上用 Certbot 的 Nginx 集成配置 HTTPS。
server {
    listen 80 default_server;
    server_name _;

    root /var/www/acove;
    index index.html;
    charset utf-8;

    # 后端单文件上传上限为 5MB，请求上限为 6MB。
    client_max_body_size 8m;

    # Vite 在 /assets/ 下输出带内容 hash 的 JS、CSS、图片与字体，可安全长期缓存。
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files  $uri =404;
    }

    # /api/article/list -> http://127.0.0.1:8080/article/list
    # proxy_pass 末尾的 / 会去掉匹配到的 /api/ 前缀。
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Vue Router history 模式：直接访问或刷新前端路由时返回 index.html。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
