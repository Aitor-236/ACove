# ============================================================
# ACove 默认 HTTP 配置：支持无域名直接通过服务器 IP 访问。
# HTTPS 配置在 nginx.https.conf.template，由 deploy.sh https 启用。
# ============================================================

server {
    listen       80 default_server;
    server_name  _;

    # certbot 的 HTTP-01 校验文件：宿主 /var/www/certbot 只读挂载到容器同路径
    location ^~ /.well-known/acme-challenge/ {
        root         /var/www/certbot;
        default_type "text/plain";
        access_log   off;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    root  /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    # 上传接口单文件上限 5MB（后端 spring.servlet.multipart 同值），留一点余量
    client_max_body_size 8m;

    # 静态资源压缩
    gzip              on;
    gzip_comp_level   5;
    gzip_min_length   1k;
    gzip_proxied      any;
    gzip_vary         on;
    gzip_types        text/plain text/css application/json application/javascript
                      application/xml text/javascript image/svg+xml;

    # Vite 在 /assets/ 下输出带内容 hash 的 JS、CSS、图片与字体，可安全长期缓存
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files  $uri =404;
    }

    # index.html 不缓存，保证发版后立刻拿到新版本
    location = /index.html {
        ssi on;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # HTML metadata is rendered before sending the SPA document, including for crawlers without JS.
    location = /_page-head {
        internal;
        ssi off;
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $page_backend http://backend:8080;
        proxy_pass $page_backend/site/page-head;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Page-URI $request_uri;
        proxy_set_header X-Page-Scheme $scheme;
        proxy_set_header X-Page-Host $http_host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
    }

    # 前端 axios 的 baseURL 是 /api，这里去掉前缀转发给后端
    # 例：/api/uploads/avatar/x.png -> http://backend:8080/uploads/avatar/x.png
    location /api/ {
        # 用 Docker 内置 DNS：后端容器单独重建后 IP 会变，
        # 写死 proxy_pass http://backend:8080/ 会缓存旧 IP 导致 /api 一直 502，
        # 这里让它每 10 秒重新解析一次。
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $backend_upstream http://backend:8080;

        # 去掉 /api 前缀：/api/article/list?page=1 -> /article/list?page=1
        rewrite ^/api/(.*)$ /$1 break;

        proxy_pass         $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # SPA 回退：/articles/1、/admin/xxx 这类地址直接刷新也能打开
    location / {
        try_files $uri $uri/ /index.html;
    }
}
